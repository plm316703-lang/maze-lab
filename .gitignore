# 빌드 결과물 (각자 컴퓨터에서 다시 만들어짐)
.gradle/
build/
out/
bin/

# 개인 IDE 설정 (사람마다 경로/화면 배치가 다름)
.idea/
*.iml
.vscode/

# 운영체제 쓰레기
.DS_Store
Thumbs.db

# 주의! gradle/wrapper/gradle-wrapper.jar 는 꼭 올린다 (gradlew 가 이걸로 돈다)
!gradle/wrapper/gradle-wrapper.jar

# 개인 연습 DB 파일 (file: 모드로 바꿨을 때)
data/
