# ============================================================
# .gitattributes : 깃이 파일을 "어떻게" 저장할지 정하는 곳
#
# 왜 필요하나?
#   윈도우는 줄바꿈이 CRLF(\r\n), 맥/리눅스는 LF(\n).
#   그냥 두면 윈도우 사람이 저장할 때마다 "모든 줄이 바뀌었다"고 나와서
#   실제로 안 고친 줄까지 충돌이 난다. 그리고 gradlew 는 CRLF 면 맥에서 실행 안 된다.
#   → 저장소 안에서는 전부 LF 로 통일한다.
# ============================================================

# 기본: 글자 파일은 LF
* text=auto eol=lf

# 윈도우 전용 실행 파일만 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 글자가 아닌 파일 (건드리지 마라)
*.jar binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
